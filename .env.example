# Copy to .env.local for local development (git-ignored).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Generate with: yarn hash-password
APP_PASSWORD_HASH=

# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Supabase → Connect → Transaction pooler (port 6543). Apply the schema with: yarn db:migrate
DATABASE_URL=

# --- Added in later milestones ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# GOOGLE_CALENDAR_ID=
# TOKEN_ENCRYPTION_KEY=
