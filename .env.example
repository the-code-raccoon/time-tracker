# Copy to .env.local for local development (git-ignored).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Generate with: yarn hash-password
APP_PASSWORD_HASH=

# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Supabase → Connect → Transaction pooler (port 6543). Apply the schema with: yarn db:migrate
DATABASE_URL=

# Google Calendar — client_id / client_secret from the OAuth web client (credentials.json).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be listed under "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
GOOGLE_CALENDAR_ID=
# Encrypts the stored Google tokens. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
